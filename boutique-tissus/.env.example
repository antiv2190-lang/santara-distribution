# Copiez ce fichier en ".env" (ne jamais publier le vrai .env)

# --- Base de données + photos : Supabase (Project Settings > API) ---
# Laissez vide pour tester en "mode démo" (données sur disque, dossier .data/)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=tissus

# --- Sécurité ---
# Secret qui signe les connexions. Mettez une longue phrase au hasard.
SESSION_SECRET=
# Code d'accès du tableau de bord super-admin (/super-admin). Gardez-le pour vous.
SUPERADMIN_CODE=

# --- Boutique par défaut ---
# Si renseigné, « / » et « /admin » pointent vers cette boutique (son "slug").
DEFAULT_SHOP=

# --- Adresse publique du site (pour les liens partagés), ex. https://tissus.onrender.com
# Facultatif : sinon elle est déduite de la requête.
PUBLIC_URL=

# --- IA (nom, catégorie, description de chaque tissu) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Amélioration de la photo ---
# local     = correction de lumière + netteté + fond élégant, fait sur le serveur (gratuit, par défaut)
# removebg  = en plus, détourage du fond via remove.bg (nécessite REMOVEBG_API_KEY)
IMAGE_PROVIDER=local
REMOVEBG_API_KEY=

PORT=3000

# --- Phases 2 et 3 (NON ACTIVÉES — laisser vide) ---
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
MOOV_MONEY_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
