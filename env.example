# Copiez ce fichier en ".env" pour tester en local (ne jamais publier le vrai .env)

# Adresse de connexion à votre base MongoDB Atlas (voir README.md, étape 1)
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/santara?retryWrites=true&w=majority

# Clé API Anthropic pour activer l'onglet "Assistant IA" (voir README.md, étape 3)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port local (Render définit celui-ci automatiquement en production, ne pas y toucher là-bas)
PORT=3000
