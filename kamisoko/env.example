# Copiez en ".env" (ne JAMAIS publier le vrai .env)
PORT=3000
NODE_ENV=production

# Compte administrateur créé au tout premier démarrage.
# Si ADMIN_PASSWORD est vide, un mot de passe aléatoire s'affiche UNE FOIS dans la console.
ADMIN_USERNAME=kamissoko
ADMIN_PASSWORD=

# Derrière un proxy (Render, Railway, Nginx…) : nombre de proxys de confiance (1 en général)
TRUST_PROXY=1

# Dossier de stockage (produits, commandes, photos). Sur Render : monter un disque persistant ici.
DATA_DIR=./data
